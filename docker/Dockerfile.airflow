# syntax=docker/dockerfile:1
ARG AIRFLOW_VERSION=3.4.0
ARG PYTHON_VERSION=3.13
ARG MICROMAMBA_VERSION=2.3.3
ARG GDAL_VERSION=3.13.3

# ============================================================================
# GDAL stage: the ELT shells out to ogr2ogr (see
# libs/data_manipulation/src/data_manipulation/ingestion.py) and needs
# GDAL >= 3.13 with the Parquet and PostgreSQL drivers.
#
# The official image (Debian 13) has the PGDG apt repository, which ships
# gdal-bin 3.13, but without the Parquet driver: Debian has no Arrow package
# ============================================================================
FROM mambaorg/micromamba:${MICROMAMBA_VERSION} AS gdal
ARG GDAL_VERSION
USER root
RUN micromamba create -y -q -p /opt/gdal -c conda-forge --override-channels \
      "libgdal-core=${GDAL_VERSION}" \
      "libgdal-pg=${GDAL_VERSION}" \
      "libgdal-arrow-parquet=${GDAL_VERSION}" \
 && micromamba clean -a -y -q

# ============================================================================
# Base stage: slim official airflow image + GDAL + the elt dependencies, shared
# by development and production.
# ============================================================================
FROM apache/airflow:slim-${AIRFLOW_VERSION}-python${PYTHON_VERSION} AS base
ARG AIRFLOW_VERSION

COPY --from=gdal /opt/gdal /opt/gdal
# Appended, not prepended: the conda prefix also ships binaries (curl, openssl,
# ...) that must not shadow the image's own.
ENV PATH=${PATH}:/opt/gdal/bin


COPY --chown=airflow:0 apps/elt/pyproject.toml apps/elt/uv.lock /tmp/src/apps/elt/
COPY --chown=airflow:0 libs/data_manipulation /tmp/src/libs/data_manipulation
RUN cd /tmp/src/apps/elt \
 && uv export --frozen --no-dev --no-emit-workspace -o /tmp/requirements.txt \
 && uv pip install --no-cache "apache-airflow==${AIRFLOW_VERSION}" -r /tmp/requirements.txt \
 && uv pip check \
 && uv build --no-cache --wheel ../../libs/data_manipulation -o /tmp/wheels \
 && rm -rf /tmp/requirements.txt

# ============================================================================
# Development stage: deps only. libs/data_manipulation is bind-mounted under
# /opt/airflow/dags by compose.airflow.yaml for hot-reload, so the wheel built
# in the base stage is deliberately not installed here.
# ============================================================================
FROM base AS development

# ============================================================================
# Production stage: same deps plus the bundled data_manipulation wheel and the
# DAG files copied from the repo.
# ============================================================================
FROM base AS production

RUN uv pip install --no-cache --no-deps /tmp/wheels/*.whl && rm -rf /tmp/wheels

# DAGs are copied (not volume-mounted) so the production image is self-contained.
COPY --chown=airflow:0 apps/elt/dags/ ${AIRFLOW_HOME}/dags/
