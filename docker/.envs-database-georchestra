# envs-database-georchestra
PGHOST=database
PGPORT=5432
PGDATABASE=georchestra
PGUSER=georchestra
PGPASSWORD=georchestra

POSTGRES_USER=${PGUSER}
POSTGRES_PASSWORD=${PGPASSWORD}

# extra env var for jdbc
GEODATA_PGDATABASE=${PGDATABASE}
GEODATA_PGHOST=${PGHOST}
GEODATA_PGPORT=${PGPORT}
GEODATA_PGUSER=${PGUSER}
GEODATA_PGPASSWORD=${PGPASSWORD}

# extra env for gs jdbc/gwc
GWC_PGDATABASE=${PGDATABASE}
GWC_PGHOST=${PGHOST}
GWC_PGPORT=${PGPORT}
GWC_PGUSERNAME=${PGUSER}
GWC_PGPASSWORD=${PGPASSWORD}

# extra env for datafeeder JNDI
DATAFEEDER_PGDATABASE=postgres
DATAFEEDER_PGHOST=datadb
DATAFEEDER_PGPORT=5432
DATAFEEDER_PGUSER=postgres
DATAFEEDER_PGPASSWORD=mypassword

# extra env for patrimoine JNDI (Lille monuments, sourcedb_direct_access, read-only user)
PATRIMOINE_PGDATABASE=patrimoine
PATRIMOINE_PGHOST=sourcedb_direct_access
PATRIMOINE_PGPORT=5432
PATRIMOINE_PGUSER=patrimoine_reader
PATRIMOINE_PGPASSWORD=patrimoine_reader_password

# source databases for the dockerized backend: overrides SOURCE_DATABASES of datafeeder.env
# (env vars take priority over the dotenv file), so hosts are compose service names
SOURCE_DATABASES={"SOURCE_DB_1": {"type": "copy", "connection_string": "postgresql://postgres:mypassword@datadb:5432/postgres"}, "SOURCE_DB_2": {"type": "copy", "connection_string": "postgresql://postgres:mypassword@sourcedb:5432/sourcedb"}, "PATRIMOINE": {"type": "direct_access", "connection_string": "postgresql://patrimoine_reader:patrimoine_reader_password@sourcedb_direct_access:5432/patrimoine", "jndi_reference": "jdbc/patrimoine", "roles": ["ADMINISTRATOR"], "label": "Patrimoine (monuments de Lille)"}}
